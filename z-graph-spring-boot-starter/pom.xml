         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
            <artifactId>z-graph</artifactId>
        <version>1.0.8</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>io.github.yuku123</groupId>
    <version>1.0.8</version>

    <artifactId>z-graph-spring-boot-starter</artifactId>
    <name>z-graph-spring-boot-starter</name>
    <description>z-graph 版本仓库与内嵌 HTTP 控制面的 Spring Boot 自动装配（z.graph.enabled=true 打开）</description>

    <url>https://github.com/yuku123/z-graph</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-graph.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-graph.git</developerConnection>
        <url>https://github.com/yuku123/z-graph</url>
        <tag>HEAD</tag>
    </scm>



    <dependencies>
        <!-- 四件的 version 都不写：z-graph-bolt-server 由仓根 DM 钉 ${project.version}；
             slf4j-api 由仓根 DM 的**直接**条目压住本仓的 2.0.13（地板那侧是 spring-boot 的 1.7.36，
             继承来的直接条目会顶掉 import，所以必须写直接条目）；
             spring-boot 两件由地板 z-boot-dependencies 的 spring-boot.version=2.7.18 下发，
             与本仓迁移前面值同一格。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-graph-bolt-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>